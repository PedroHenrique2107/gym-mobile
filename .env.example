# =============================================================================
# gym-mobile — exemplo de configuracao
#
# Copie para `.env.local` e preencha. Arquivos `.env*` reais sao ignorados pelo
# Git. Nenhum valor real deve ser escrito neste arquivo de exemplo.
#
# ATENCAO: toda variavel com prefixo NEXT_PUBLIC_ e incorporada ao bundle
# enviado ao navegador e fica visivel para qualquer usuario. Por isso apenas
# valores publicos aparecem aqui.
#
# Nunca coloque neste repositorio:
#   - SUPABASE_SECRET_KEY / SERVICE_ROLE_KEY
#   - DATABASE_URL / DIRECT_URL
#   - VAPID_PRIVATE_KEY
# Esses segredos pertencem exclusivamente ao gym-service.
#
# Nenhuma variavel do gym-mobile-lovable deve ser copiada para ca.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development

# --- API de negocio ----------------------------------------------------------
# Origem do gym-service, sem barra no final. O prefixo /api/v1 e adicionado
# pelo cliente HTTP, entao nao deve entrar aqui.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Supabase Auth -----------------------------------------------------------
# Apenas URL e publishable key chegam ao navegador. A publishable key e
# projetada para ser publica: o isolamento real vem da autorizacao no
# gym-service, nao do sigilo desta chave.
# Preencher a partir da fase M2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Web Push ----------------------------------------------------------------
# Somente a chave publica VAPID. A privada fica no gym-service.
# Preencher a partir da fase M6.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
